<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../FreshWorld.local.props" Condition="Exists('../FreshWorld.local.props')" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GameDir Condition="'$(GameDir)' == '' and '$(ValheimDedicatedDir)' != ''">$(ValheimDedicatedDir)</GameDir>
    <GameDir Condition="'$(GameDir)' == ''">C:/Program Files (x86)/Steam/steamapps/common/Valheim</GameDir>
    <ManagedDir Condition="'$(ManagedDir)' == '' and Exists('$(GameDir)/valheim_Data/Managed')">$(GameDir)/valheim_Data/Managed</ManagedDir>
    <ManagedDir Condition="'$(ManagedDir)' == ''">$(GameDir)/valheim_server_Data/Managed</ManagedDir>
    <BepInExDir Condition="'$(BepInExDir)' == ''">$(GameDir)/BepInEx/core</BepInExDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Mono.Cecil" HintPath="$(BepInExDir)/Mono.Cecil.dll" />
    <Reference Include="0Harmony" HintPath="$(BepInExDir)/0Harmony.dll" />
    <Reference Include="BepInEx" HintPath="$(BepInExDir)/BepInEx.dll" />
    <Reference Include="MonoMod.RuntimeDetour" HintPath="$(BepInExDir)/MonoMod.RuntimeDetour.dll" />
    <Reference Include="MonoMod.Utils" HintPath="$(BepInExDir)/MonoMod.Utils.dll" />
    <Reference Include="assembly_valheim" HintPath="$(ManagedDir)/assembly_valheim.dll" />
    <Reference Include="assembly_utils" HintPath="$(ManagedDir)/assembly_utils.dll" />
    <Reference Include="SoftReferenceableAssets" HintPath="$(ManagedDir)/SoftReferenceableAssets.dll" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(ManagedDir)/UnityEngine.CoreModule.dll" />
    <None Include="$(ManagedDir)/UnityEngine.dll;$(ManagedDir)/UnityEngine.IMGUIModule.dll;$(ManagedDir)/UnityEngine.PhysicsModule.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
