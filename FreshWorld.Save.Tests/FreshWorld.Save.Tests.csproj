<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../FreshWorld.local.props" Condition="Exists('../FreshWorld.local.props')" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GameDir Condition="'$(GameDir)' == '' and '$(ValheimDedicatedDir)' != ''">$(ValheimDedicatedDir)</GameDir>
    <GameDir Condition="'$(GameDir)' == '' and '$(OS)' == 'Windows_NT'">C:/Program Files (x86)/Steam/steamapps/common/Valheim</GameDir>
    <GameDir Condition="'$(GameDir)' == ''">$(HOME)/.local/share/Steam/steamapps/common/Valheim</GameDir>
    <ManagedDir Condition="'$(ManagedDir)' == '' and Exists('$(GameDir)/valheim_Data/Managed')">$(GameDir)/valheim_Data/Managed</ManagedDir>
    <ManagedDir Condition="'$(ManagedDir)' == '' and Exists('$(GameDir)/valheim_server_Data/Managed')">$(GameDir)/valheim_server_Data/Managed</ManagedDir>
    <ManagedDir Condition="'$(ManagedDir)' == ''">$(GameDir)/valheim_Data/Managed</ManagedDir>
    <BepInExDir Condition="'$(BepInExDir)' == ''">$(GameDir)/BepInEx/core</BepInExDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../FreshWorld/Engine/EmptyChunkSavePatch.cs" Link="Production/EmptyChunkSavePatch.cs" />
    <AssemblyMetadata Include="ManagedDir" Value="$(ManagedDir)" />
    <AssemblyMetadata Include="BepInExDir" Value="$(BepInExDir)" />
    <!-- No game stubs or publicized references. Resolve original DLLs from the selected snapshot. -->
    <Reference Include="assembly_valheim" HintPath="$(ManagedDir)/assembly_valheim.dll" Private="false" ExternallyResolved="true" />
    <Reference Include="assembly_utils" HintPath="$(ManagedDir)/assembly_utils.dll" Private="false" ExternallyResolved="true" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(ManagedDir)/UnityEngine.CoreModule.dll" Private="false" ExternallyResolved="true" />
    <Reference Include="0Harmony" HintPath="$(BepInExDir)/0Harmony.dll" Private="false" ExternallyResolved="true" />
  </ItemGroup>
</Project>
